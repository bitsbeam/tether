module Tether
  # Whatever a caller may pass for a timeout: a deadline, a number of seconds, or nil for no limit.
  type timeout = Deadline | Numeric | nil

  class Deadline
    NONE: nil

    attr_reader at: Float?

    def self.after: (Numeric? seconds) -> Deadline
    def self.infinite: () -> Deadline
    def self.coerce: (timeout value) -> Deadline
    def self.now: () -> Float

    def initialize: (Float? at) -> void
    def infinite?: () -> bool
    def remaining: () -> Float?
    def expired?: () -> bool
    def check!: (?String? subject) -> void
    def with_at_most: (Numeric? seconds) -> Deadline
    def earliest: (Deadline other) -> Deadline
    def inspect: () -> String
  end
end
