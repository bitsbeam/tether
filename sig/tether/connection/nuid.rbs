module Tether
  module Connection
    module NUID
      DIGITS: String
      BASE: Integer
      PREFIX_LENGTH: Integer
      SEQUENCE_LENGTH: Integer
      TOTAL_LENGTH: Integer
      MAX_SEQUENCE: Integer
      MIN_INCREMENT: Integer
      MAX_INCREMENT: Integer
      PADDING: String
      LOCK: Thread::Mutex

      self.@prefix: String
      self.@sequence: Integer
      self.@increment: Integer
      self.@pid: Integer

      def self.next: () -> String

      private

      def self.render: () -> String
      def self.reseed!: () -> void
    end
  end
end
