module Tether
  module Connection
    class Subscription
      type state = :active | :draining | :closed
      type outcome = :queued | :last | :slow | :dropped | :closed

      BATCH: Integer

      attr_reader sid: String
      attr_reader subject: String
      attr_reader queue: String?
      attr_reader client: Client

      @max_pending: Integer
      @max_pending_bytes: Integer
      @max: Integer?
      @block: (^(Protocol::Msg msg) -> void)?
      @lock: Thread::Mutex
      @messages: Thread::Queue
      @finished: Thread::Queue
      @close_handlers: Array[^() -> void]
      @pending: Integer
      @pending_bytes: Integer
      @received: Integer
      @delivered: Integer
      @dropped: Integer
      @state: state
      @slow: bool
      @error: Exception?
      @concurrency: Integer
      @dedicated: bool
      @jobs: Integer
      @pool: WorkerPool?

      def initialize: (client: Client, sid: String, subject: String, max_pending: Integer, max_pending_bytes: Integer, ?queue: String?, ?max: Integer?, ?concurrency: Integer, ?dedicated: bool) ?{ (Protocol::Msg msg) -> void } -> void
      def deliver: (Protocol::Msg msg) -> bool
      def next: (?timeout: timeout) -> Protocol::Msg
      def each: (?idle_timeout: Numeric?) { (Protocol::Msg msg) -> void } -> self
              | (?idle_timeout: Numeric?) -> Enumerator[Protocol::Msg, self]
      def unsubscribe: (?after: Integer?) -> self
      def drain: (?timeout: timeout) -> self
      def start_drain: () -> bool
      def finish_drain: (Deadline deadline) -> void
      def close: (?Exception? error) -> void
      def run: () -> bool
      def abandon: () -> void
      def fail: (Exception error) -> void
      def replay_frames: () -> String
      def on_close: () { () -> void } -> self
      def pending: () -> Integer
      def pending_bytes: () -> Integer
      def delivered: () -> Integer
      def dropped: () -> Integer
      def max_pending: () -> Integer
      def max_pending=: (Integer limit) -> Integer
      def max_pending_bytes: () -> Integer
      def max_pending_bytes=: (Integer limit) -> Integer
      def closed?: () -> bool
      def draining?: () -> bool
      def inspect: () -> String

      private

      def positive_limit: (untyped limit, Symbol name) -> Integer
      def admit: (Protocol::Msg msg) -> outcome
      def overflow: () -> (:slow | :dropped)
      def limit: (Integer count) -> bool
      def account: (Protocol::Msg msg) -> Protocol::Msg
      def finish_intake: () -> void
      def own_pool: () -> WorkerPool
      def claim_job: () -> bool
      def more?: () -> bool
      def job_done: () -> void
      def idle?: () -> bool
      def invoke: (Protocol::Msg msg) -> void
      def finished: () -> void
    end

    class Resolver
      attr_reader sid: String
      attr_reader subject: String
      attr_reader client: Client

      @block: ^(Protocol::Msg msg) -> void
      @closed: bool

      def initialize: (client: Client, sid: String, subject: String) { (Protocol::Msg msg) -> void } -> void
      def deliver: (Protocol::Msg msg) -> void
      def unsubscribe: () -> void
      def close: (?Exception? _error) -> void
      alias abandon close
      def closed?: () -> bool
      def replay_frames: () -> String
    end
  end
end
