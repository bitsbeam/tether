module Tether
  module Connection
    class Transport
      type io = Socket | OpenSSL::SSL::SSLSocket
      type direction = :readable | :writable

      READ_SIZE: Integer

      attr_reader uri: URI::Generic

      @socket: Socket?
      @io: io?
      @tls: bool

      def self.for: (URI::Generic uri, Options options) -> Transport

      def initialize: (URI::Generic uri) -> void
      def open: (Deadline deadline) -> self
      def upgrade_to_tls: (OpenSSL::SSL::SSLContext context, String hostname, Deadline deadline) -> self
      def tls?: () -> bool
      def read: (?Deadline deadline) -> String?
      def write: (String data, ?Deadline deadline) -> Integer
      def close: () -> void
      def abandon: () -> void
      def closed?: () -> bool

      private

      def label: () -> String
      def negotiate: (OpenSSL::SSL::SSLSocket tls, Deadline deadline) -> void
      def write_some: (io io, String chunk, Deadline deadline) -> Integer
      def wait: (direction direction, Deadline deadline, String action) -> void
    end
  end
end
