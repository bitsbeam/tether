module Tether
  module Connection
    class Inbox
      INBOX_PREFIX: String

      attr_reader prefix: String

      @client: Client
      @max_pending: Integer
      @pending: Hash[String, Thread::Queue]
      @lock: Thread::Mutex
      @counter: Integer
      @subscription: Subscription?

      def initialize: (Client client, ?prefix: String?, ?max_pending: Integer) -> void
      def request: (String subject, ?String? payload, ?deadline: Deadline, ?headers: Protocol::Headers?) -> Protocol::Msg
      def start: () -> Subscription
      def started?: () -> bool
      def pending: () -> Integer
      def close: () -> void

      private

      def await: (Thread::Queue waiter, String subject, Deadline deadline) -> Protocol::Msg
      def resolve: (Protocol::Msg msg) -> void
      def next_token: () -> String
    end
  end
end
