module Tether
  module Connection
    class Inbox
      attr_reader prefix: String

      @client: Client
      @offset: Integer
      @pending: Hash[String, Thread::Queue]
      @lock: Thread::Mutex
      @counter: Integer
      @resolver: Resolver?
      @listener: Events::Registration?

      def initialize: (Client client) -> void
      def request: (String subject, String? payload, deadline: Deadline, ?headers: Client::headers?) -> Protocol::Msg
      def pending: () -> Integer
      def fail_all: (Exception error) -> void

      private

      def start: () -> void
      def interrupted: (Symbol event) -> void
      def register: (Thread::Queue waiter) -> String
      def await: (Thread::Queue waiter, String subject, Deadline deadline) -> Protocol::Msg
      def resolve: (Protocol::Msg msg) -> void
    end
  end
end
