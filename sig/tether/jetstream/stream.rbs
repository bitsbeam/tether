module Tether
  class JetStream
    class Stream
      attr_reader name: String
      attr_reader jetstream: JetStream
      attr_reader cached_info: StreamInfo

      @api: API

      def initialize: (JetStream jetstream, StreamInfo info) -> void
      def info: (?deleted_details: bool, ?subjects: String?, ?timeout: Tether::timeout) -> StreamInfo
      def config: () -> StreamConfig
      def state: () -> StreamState
      def update: (?timeout: Tether::timeout, **untyped changes) -> self
      def purge: (?subject: String?, ?sequence: Integer?, ?keep: Integer?, ?timeout: Tether::timeout) -> Integer
      def get: (?Integer? sequence, ?last_for: String?, ?next_for: String?, ?from: Integer?, ?direct: bool?, ?timeout: Tether::timeout) -> StoredMessage
      def each_message: (?from: Integer, ?subject: String?, ?start_time: Time?, ?batch: Integer, ?max_bytes: Integer?, ?timeout: Tether::timeout) { (StoredMessage message) -> void } -> self
                      | (?from: Integer, ?subject: String?, ?start_time: Time?, ?batch: Integer, ?max_bytes: Integer?, ?timeout: Tether::timeout) -> Enumerator[StoredMessage, self]
      def last_messages: (Array[String] | String subjects, ?up_to_sequence: Integer?, ?up_to_time: Time?, ?timeout: Tether::timeout) -> Array[StoredMessage]
      def delete_message: (Integer sequence, ?erase: bool, ?timeout: Tether::timeout) -> true
      def step_down: (?placement: (Placement | Hash[Symbol, untyped])?, ?timeout: Tether::timeout) -> true
      def remove_peer: (String name, ?timeout: Tether::timeout) -> true
      def snapshot: (?no_consumers: bool, ?chunk_size: Integer?, ?timeout: Tether::timeout) { (String chunk) -> void } -> [ StreamConfig, StreamState ]
      def delete: (?timeout: Tether::timeout) -> bool
      def inspect: () -> String

      private

      def direct_get: () -> DirectGet
      def confirm: (Hash[String, untyped] response, String action) -> true
      def merge_subject_pages: (Hash[String, untyped] response, Hash[String, untyped] request, Deadline deadline) -> Hash[String, untyped]
    end
  end
end
