module Tether
  module Protocol
    class Dispatcher
      @connection: Connection::Lifecycle
      @registry: Registry
      @writer: Connection::Writer
      @counters: Counters

      def initialize: (connection: Connection::Lifecycle, registry: Registry, writer: Connection::Writer, counters: Counters) -> void

      def on_msg: (String subject, String sid, String? reply_to, String? header_bytes, String payload) -> void
      def on_ping: () -> void
      def on_pong: () -> void
      def on_ok: () -> void
      def on_info: (String json) -> void
      def on_error: (String description) -> void
      def on_protocol_error: (String message) -> void
    end
  end
end
