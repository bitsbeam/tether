module Tether
  module Protocol
    class Dispatcher
      attr_reader registry: Registry
      attr_reader errors: ErrorHolder
      attr_reader server_info: Hash[String, untyped]?

      @connection: Client
      @pongs: Thread::Queue

      def initialize: (Client connection, ?registry: Registry, ?errors: ErrorHolder) -> void
      def await_pong: (Deadline deadline) -> bool?
      def close: () -> void

      def on_msg: (String subject, String sid, String? reply_to, String? header_bytes, String payload) -> void
      def on_ping: () -> void
      def on_pong: () -> void
      def on_ok: () -> void
      def on_info: (String json) -> void
      def on_error: (String description) -> void
      def on_protocol_error: (String message) -> void
    end
  end
end
