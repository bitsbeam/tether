module Tether
  module Protocol
    class Parser
      COMPACT_THRESHOLD: Integer
      SHORT_REMAINDER: Integer
      SNIPPET_LIMIT: Integer
      AWAITING_CONTROL_LINE: :control
      AWAITING_PAYLOAD: :payload
      MSG_LINE: Regexp
      HMSG_LINE: Regexp
      CR: Integer
      LF: Integer
      UPPER_M: Integer
      LOWER_M: Integer
      UPPER_H: Integer
      LOWER_H: Integer
      UPPER_P: Integer
      LOWER_P: Integer
      UPPER_I: Integer
      LOWER_I: Integer
      PLUS: Integer
      MINUS: Integer
      UPPER_A: Integer
      UPPER_Z: Integer
      CASE_SHIFT: Integer

      attr_accessor max_payload: Integer?
      attr_writer dispatcher: _Dispatcher

      @max_control_line: Integer
      @buffer: String
      @position: Integer
      @awaiting_payload: bool
      @broken: bool
      @subject: String?
      @sid: String?
      @reply_to: String?
      @needed: Integer?
      @header_size: Integer?

      def initialize: (_Dispatcher dispatcher, ?max_control_line: Integer, ?max_payload: Integer?) -> void
      def state: () -> (:control | :payload)
      def feed: (String? data) -> self
      def reset!: () -> void
      def broken?: () -> bool
      def pending_bytes: () -> Integer

      private

      def run: () -> void
      def reject_sizes: (String subject, Integer? header_size, Integer needed) -> false
      def dispatch: (Integer start, Integer line_end) -> bool
      def dispatch_ping_pong: (Integer start, Integer line_end) -> bool
      def dispatch_ok: (Integer start, Integer line_end) -> bool
      def dispatch_err: (Integer start, Integer line_end) -> bool
      def dispatch_info: (Integer start, Integer line_end) -> bool
      def verb?: (Integer start, Integer limit, String verb) -> bool
      def trimmed: (Integer from, Integer to) -> String
      def snippet: (Integer start, Integer line_end) -> String
      def clear_frame: () -> void
      def compact: () -> void
      def malformed: (Integer start, Integer line_end) -> false
      def unknown_operation: (Integer start, Integer line_end) -> false
      def fail_protocol!: (String message) -> false
    end
  end
end
