module Tether
  module Protocol
    class Registry
      @entries: Hash[String, Connection::entry]
      @lock: Thread::Mutex
      @sid: Integer

      def initialize: () -> void
      def next_sid: () -> String
      def add: (Connection::Subscription entry) -> Connection::Subscription
             | (Connection::Resolver entry) -> Connection::Resolver
      def remove: (String sid) -> Connection::entry?
      def []: (String sid) -> Connection::entry?
      def to_a: () -> Array[Connection::entry]
      def size: () -> Integer
      def replay_frames: () -> String
      def close: (?Exception? error) -> void
      def abandon: () -> void

      private

      def take: () -> Array[Connection::entry]
    end
  end
end
