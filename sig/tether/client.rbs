module Tether
  def self.connect: (?String? uri, **untyped options) ?{ (Client) -> untyped } -> untyped

  class Client
    DEFAULT_URI: String
    DEFAULT_CONNECT_TIMEOUT: Integer
    DEFAULT_FLUSH_TIMEOUT: Integer
    DEFAULT_REQUEST_TIMEOUT: Integer

    attr_reader status: Symbol
    attr_reader transport: Connection::Transport?

    @uri: String
    @options: Hash[Symbol, untyped]
    @sid_counter: Integer
    @lock: Thread::Mutex
    @flush_signal: Thread::SizedQueue
    @flusher: Thread?
    @dispatcher: Protocol::Dispatcher?
    @parser: Protocol::Parser?
    @reader: Thread?
    @inbox: Connection::Inbox?

    def self.connect: (?String? uri, **untyped options) ?{ (Client) -> untyped } -> untyped

    def initialize: (?String? uri, **untyped options) -> void
    def connect: (?timeout: Numeric?) -> self
    def publish: (String subject, ?String? payload, ?reply_to: String?, ?headers: Protocol::Headers?, ?flush: bool) -> void
    def subscribe: (String subject, ?queue: String?, ?max_pending: Integer) ?{ (Protocol::Msg) -> void } -> Connection::Subscription
    def unsubscribe: (Connection::Subscription subscription, ?Integer? max_msgs) -> void
    def request: (String subject, ?String? payload, ?timeout: Numeric?, ?headers: Protocol::Headers?) -> Protocol::Msg
    def build_inbox_subject: () -> String
    def flush: (?timeout: Numeric?) -> bool
    def close: () -> void
    def connected?: () -> bool
    def closed?: () -> bool
    def on_error: () { (Exception) -> void } -> void
    def server_info: () -> Hash[String, untyped]?
    def last_error: () -> Exception?
    def subscription_count: () -> Integer
    def max_payload: () -> Integer?

    private

    def inbox: () -> Connection::Inbox
    def dispatcher: () -> Protocol::Dispatcher
    def parser: () -> Protocol::Parser
    def read_server_info: (Deadline deadline) -> void
    def connect_options: () -> Hash[Symbol, untyped]
    def start_reader: () -> Thread
    def start_flusher: () -> Thread
    def flush_loop: () -> void
    def kick_flusher: () -> void
    def read_loop: () -> void
    def next_sid: () -> String
    def check_payload_size!: (String subject, String frame) -> void
    def report_slow_consumer: (Connection::Subscription subscription) -> void
    def ensure_connected!: () -> void
  end
end
